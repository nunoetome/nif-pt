# =============================================================================
# nif-pt — Template de segredos
# Copiar para .env:  cp config/.env.example config/.env
# Nunca commitar .env (está em .gitignore)
# =============================================================================

# NIF.pt — obter em http://www.nif.pt/contactos/api/
NIF-PT-KEY=coloque_a_sua_chave_aqui

# Azure SQL — portal.azure.com → SQL → Connection strings
# Necessário apenas para importar_nif.py (Azure SQL)
AZURE_USER=seu_user_aqui
AZURE_PALAVRA_CHAVE=sua_password_aqui

# Opcional — futuro uso em api/
# API_TOKEN=seu_token_aqui
